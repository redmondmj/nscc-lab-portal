# Proxmox API Configuration
# Host IP or FQDN of your Proxmox node/cluster
PROXMOX_HOST=10.10.0.11

# Proxmox API user (e.g. root@pam or api-user@pve)
PROXMOX_API_USER=root@pam

# API Token ID created in Proxmox Datacenter -> Permissions -> API Tokens
PROXMOX_API_TOKEN_ID=getvm

# API Token Secret (UUID format)
PROXMOX_API_TOKEN_SECRET=your-token-secret-here

# Optional: Port for Flask app (defaults to 5000)
PORT=5000

# Proxmox SPICE proxy port (defaults to 3128)
PROXMOX_SPICE_PORT=3128
