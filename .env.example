# Proxmox API Configuration
PROXMOX_HOST=10.10.0.11
PROXMOX_API_USER=student@pve
PROXMOX_API_TOKEN_ID=getvm
PROXMOX_API_TOKEN_SECRET=your-token-secret-uuid
PROXMOX_SPICE_PORT=3128
PORT=5000

# Microsoft Entra ID (Azure AD) SSO Configuration
ENTRA_CLIENT_ID=your-application-client-id-uuid
ENTRA_CLIENT_SECRET=your-client-secret-value
ENTRA_TENANT_ID=your-directory-tenant-id-uuid
ENTRA_REDIRECT_URI=http://localhost:5000/auth/callback
# In production with domain/NPM:
# ENTRA_REDIRECT_URI=https://labs.nscctruro.ca/auth/callback

# Flask Session Security Key (random string to sign cookies)
SECRET_KEY=generate-any-random-string-or-uuid

# Instructor / Admin Access (comma-separated emails granted /admin rights)
ADMIN_EMAILS=your.email@campus.nscc.ca,your.email@nscc.ca

# Cloudflare Zero Trust Tunnel Token (for remote student access via WARP / ZTNA)
CLOUDFLARE_TUNNEL_TOKEN=eyJh...

